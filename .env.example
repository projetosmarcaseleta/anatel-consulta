# Porta no HOST da VPS (porta interna continua 3000, livre de conflitos)
APP_PORT=3035

# Configuração do Banco de Dados PostgreSQL
POSTGRES_USER=anatel_user
POSTGRES_PASSWORD=altere_esta_senha_segura_123
POSTGRES_DB=anatelbase

# URLs de conexão usadas pelo Prisma e pela aplicação Next.js
# No Docker Compose, o host do banco é o container 'db'
DATABASE_URL=postgresql://anatel_user:altere_esta_senha_segura_123@db:5432/anatelbase
DIRECT_URL=postgresql://anatel_user:altere_esta_senha_segura_123@db:5432/anatelbase
